# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
build/
dist/
*.egg-info/
*.egg
.eggs/

# ── Virtual environments ─────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Jupyter ──────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── Data — never commit raw or processed data files ──────────────────────────
data/raw/*
data/interim/*
data/processed/*
# Keep the directory structure in git
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# ── Reports & figures (large outputs) ────────────────────────────────────────
reports/figures/*
!reports/figures/.gitkeep

# ── MLflow ───────────────────────────────────────────────────────────────────
mlruns/
mlartifacts/

# ── Model artefacts ──────────────────────────────────────────────────────────
*.pkl
*.joblib
*.model
*.json.gz

# ── Parquet / Arrow / DuckDB ─────────────────────────────────────────────────
*.parquet
*.arrow
*.duckdb
*.db

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/

# ── OS & editor ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ── Secrets / credentials ────────────────────────────────────────────────────
.env
*.env
secrets.yaml
credentials.json
api_keys.txt

# ── pytest / coverage ────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# ── Ruff / linting caches ────────────────────────────────────────────────────
.ruff_cache/

# ── mypy ─────────────────────────────────────────────────────────────────────
.mypy_cache/
